<%- include('partials/header') %>

<style>
    .hotel-card { background: white; border-radius: 12px; border: 1px solid var(--border); box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05); margin-bottom: 24px; overflow: hidden; }
    .hotel-header { background: #f8fafc; padding: 16px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
    .hotel-header h2 { margin: 0; font-size: 18px; color: #0f172a; display: flex; align-items: center; gap: 8px; }
    .hotel-body { padding: 24px; display: none; }
    .hotel-body.open { display: block; }

    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .input-group { display: flex; flex-direction: column; gap: 6px; }
    .input-group label { font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; }
    .input-group input, .input-group select { padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; outline: none; transition: 0.2s; background: #fff; }
    .input-group input:focus, .input-group select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1); }
    
    .section-title { font-size: 14px; font-weight: 700; color: #1e293b; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;}
    
    .season-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
    .season-table th { text-align: left; padding: 10px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; }
    .season-table td { padding: 10px; border-bottom: 1px solid #f1f5f9; }

    .btn { padding: 10px 16px; border-radius: 6px; font-weight: 700; font-size: 13px; cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 6px; transition: 0.2s; }
    .btn-primary { background: #10b981; color: white; }
    .btn-primary:hover { background: #059669; }
    .btn-danger { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }
    .btn-danger:hover { background: #f87171; color: white; }
    .btn-outline { background: white; border: 1px solid #cbd5e1; color: #475569; }

    .add-new-panel { background: #ecfdf5; border: 1px dashed #10b981; border-radius: 12px; padding: 24px; margin-bottom: 32px; }
</style>

<div class="grid-container">
    <div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1 style="margin: 0 0 4px 0; font-size: 24px;">Static Rates Engine</h1>
            <p style="color: var(--text-muted); margin: 0; font-size: 14px;">Manage dynamic fallback pricing for hotels.</p>
        </div>
        <button class="btn btn-primary" onclick="document.getElementById('addHotelPanel').style.display = 'block'">
            <i data-lucide="plus"></i> Add New Hotel
        </button>
    </div>

    <div id="addHotelPanel" class="add-new-panel" style="display: none;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
            <h3 style="margin: 0; color: #065f46;"><i data-lucide="building" style="width: 18px; vertical-align: -3px;"></i> Create New Hotel Rule</h3>
            <button class="btn btn-outline" style="padding: 4px 8px;" onclick="document.getElementById('addHotelPanel').style.display = 'none'">Cancel</button>
        </div>
        
        <form action="/static-rates/hotel/add" method="POST">
            <div class="form-grid">
                <div class="input-group"><label>Hotel Name</label><input type="text" name="hotel_name" required></div>
                <div class="input-group"><label>Aliases (Comma separated)</label><input type="text" name="aliases" placeholder="e.g. Voco, Voco Towers"></div>
                <div class="input-group"><label>Is Room Rate Flat? (Regardless of Pax)</label><select name="is_room_rate_flat"><option value="">No (Calculated by Pax)</option><option value="1">Yes (Flat Rate)</option></select></div>
                <div class="input-group"><label>Base Rate Covers Till Pax</label><input type="number" name="flat_till_pax" value="2" required></div>
                <div class="input-group"><label>Max Pax Allowed</label><input type="number" name="max_pax" value="4" required></div>
                <div class="input-group"><label>Default Extra Bed Rate</label><input type="number" name="default_extra_bed_rate" value="100"></div>
                <div class="input-group"><label>Are Weekends Flat?</label><select name="is_weekend_flat"><option value="1">Yes (Same as Weekday)</option><option value="">No (Separate Rate)</option></select></div>
                <div class="input-group"><label>Is Meal Included in Base?</label><select name="meal_included"><option value="">No</option><option value="1">Yes</option></select></div>
            </div>

            <h4 style="margin: 16px 0 8px 0; font-size: 13px; color: #475569;">Surcharges (Leave 0 if none)</h4>
            <div class="form-grid" style="grid-template-columns: repeat(6, 1fr);">
                <div class="input-group"><label>BB (SAR)</label><input type="number" name="meal_bb" value="0"></div>
                <div class="input-group"><label>Sahour (SAR)</label><input type="number" name="meal_sahour" value="0"></div>
                <div class="input-group"><label>Iftar (SAR)</label><input type="number" name="meal_iftar" value="0"></div>
                <div class="input-group"><label>Lunch/Dinner</label><input type="number" name="meal_ld" value="0"></div>
                <div class="input-group"><label>Haram View</label><input type="number" name="view_haram" value="0"></div>
                <div class="input-group"><label>City View</label><input type="number" name="view_city" value="0"></div>
            </div>
            
            <button type="submit" class="btn btn-primary"><i data-lucide="check-circle"></i> Save New Hotel</button>
        </form>
    </div>

    <% hotels.forEach(hotel => { %>
        <div class="hotel-card">
            <div class="hotel-header" onclick="toggleHotel('<%= hotel.hotel_id %>')">
                <h2><i data-lucide="building-2" style="color: #3b82f6;"></i> <%= hotel.hotel_name %></h2>
                <span style="color: #94a3b8; font-size: 12px; font-weight: 700;"><%= hotel.seasons.length %> Seasons Configured <i data-lucide="chevron-down" style="vertical-align: -5px; width: 16px;"></i></span>
            </div>
            
            <div class="hotel-body" id="body_<%= hotel.hotel_id %>">
                
                <div class="section-title">Global Hotel Settings
                    <form action="/static-rates/hotel/delete/<%= hotel.hotel_id %>" method="POST" style="margin:0;" onsubmit="return confirm('WARNING: This will delete the hotel and ALL its seasons permanently. Are you sure?');">
                        <button type="submit" class="btn btn-danger" style="padding: 4px 8px; font-size: 11px;"><i data-lucide="trash" style="width: 14px;"></i> Delete Entire Hotel</button>
                    </form>
                </div>
                <form action="/static-rates/hotel/edit/<%= hotel.hotel_id %>" method="POST" style="margin-bottom: 32px; background: #f8fafc; padding: 16px; border-radius: 8px;">
                    <div class="form-grid">
                        <div class="input-group"><label>Hotel Name</label><input type="text" name="hotel_name" value="<%= hotel.hotel_name %>" required></div>
                        <div class="input-group"><label>Aliases</label><input type="text" name="aliases" value="<%= hotel.aliases_str %>"></div>
                        <div class="input-group"><label>Is Room Rate Flat?</label><select name="is_room_rate_flat"><option value="" <%= hotel.is_room_rate_flat===0?'selected':'' %>>No (Calculated by Pax)</option><option value="1" <%= hotel.is_room_rate_flat===1?'selected':'' %>>Yes (Flat Rate)</option></select></div>
                        <div class="input-group"><label>Base Covers Till Pax</label><input type="number" name="flat_till_pax" value="<%= hotel.flat_till_pax %>"></div>
                        <div class="input-group"><label>Max Pax</label><input type="number" name="max_pax" value="<%= hotel.max_pax %>"></div>
                        <div class="input-group"><label>Default Extra Bed Rate</label><input type="number" name="default_extra_bed_rate" value="<%= hotel.default_extra_bed_rate %>"></div>
                        <div class="input-group"><label>Are Weekends Flat?</label><select name="is_weekend_flat"><option value="1" <%= hotel.is_weekend_flat===1?'selected':'' %>>Yes (Same as Weekday)</option><option value="" <%= hotel.is_weekend_flat===0?'selected':'' %>>No (Separate Rate)</option></select></div>
                        <div class="input-group"><label>Is Meal Included?</label><select name="meal_included"><option value="" <%= hotel.meal_included===0?'selected':'' %>>No</option><option value="1" <%= hotel.meal_included===1?'selected':'' %>>Yes</option></select></div>
                    </div>

                    <div class="form-grid" style="grid-template-columns: repeat(6, 1fr);">
                        <div class="input-group"><label>BB (+SAR)</label><input type="number" name="meal_bb" value="<%= hotel.meals.bb || 0 %>"></div>
                        <div class="input-group"><label>Sahour (+SAR)</label><input type="number" name="meal_sahour" value="<%= hotel.meals.sahour || 0 %>"></div>
                        <div class="input-group"><label>Iftar (+SAR)</label><input type="number" name="meal_iftar" value="<%= hotel.meals.iftar || 0 %>"></div>
                        <div class="input-group"><label>L/D (+SAR)</label><input type="number" name="meal_ld" value="<%= hotel.meals.lunch_dinner || 0 %>"></div>
                        <div class="input-group"><label>Haram View</label><input type="number" name="view_haram" value="<%= hotel.views.haram || 0 %>"></div>
                        <div class="input-group"><label>City View</label><input type="number" name="view_city" value="<%= hotel.views.city || 0 %>"></div>
                    </div>
                    <button type="submit" class="btn btn-outline" style="background: white;"><i data-lucide="save"></i> Update Core Settings</button>
                </form>

                <div class="section-title">Seasonal Rates Configuration</div>
                <% if(hotel.seasons.length > 0) { %>
                    <table class="season-table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Date Range</th>
                                <th style="color: #10b981;">WD Base (SAR)</th>
                                <th style="color: #10b981;">WD Bed</th>
                                <th style="color: #3b82f6;">WE Base (SAR)</th>
                                <th style="color: #3b82f6;">WE Bed</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% hotel.seasons.forEach(season => { %>
                                <tr>
                                    <td style="font-weight: 700;"><%= season.description %></td>
                                    <td><span style="background: #f1f5f9; padding: 4px 8px; border-radius: 4px; font-family: monospace;"><%= season.start_date %> to <%= season.end_date %></span></td>
                                    <td style="font-weight: 700;"><%= season.weekday_sd_rate %></td>
                                    <td><%= season.weekday_eb_rate || '-' %></td>
                                    <td style="font-weight: 700;"><%= season.weekend_sd_rate %></td>
                                    <td><%= season.weekend_eb_rate || '-' %></td>
                                    <td style="text-align: right;">
                                        <form action="/static-rates/season/delete/<%= season.season_id %>" method="POST" style="margin:0;">
                                            <button type="submit" class="btn btn-danger" style="padding: 6px;"><i data-lucide="trash-2" style="width: 14px;"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p style="color: #64748b; font-size: 13px; margin-bottom: 16px;">No seasons configured. This hotel will not generate rates.</p>
                <% } %>

                <form action="/static-rates/season/add/<%= hotel.hotel_id %>" method="POST" style="background: #eff6ff; padding: 16px; border-radius: 8px; border: 1px dashed #bfdbfe;">
                    <div style="font-size: 12px; font-weight: 700; color: #1d4ed8; text-transform: uppercase; margin-bottom: 12px;">+ Add New Season</div>
                    <div class="form-grid" style="grid-template-columns: repeat(7, 1fr); margin-bottom: 12px; gap: 8px;">
                        <div class="input-group" style="grid-column: span 2;"><input type="text" name="description" placeholder="e.g. Ramadan Last 10" required></div>
                        <div class="input-group"><input type="text" name="start_date" placeholder="Start (MM-DD)" required pattern="\d{2}-\d{2}"></div>
                        <div class="input-group"><input type="text" name="end_date" placeholder="End (MM-DD)" required pattern="\d{2}-\d{2}"></div>
                        <div class="input-group"><input type="number" name="weekday_sd_rate" placeholder="WD Base SAR" required></div>
                        <div class="input-group"><input type="number" name="weekend_sd_rate" placeholder="WE Base SAR"></div>
                        <button type="submit" class="btn btn-primary" style="justify-content: center;">Add</button>
                    </div>
                </form>

            </div>
        </div>
    <% }); %>

</div>

<script>
    function toggleHotel(id) {
        const body = document.getElementById('body_' + id);
        if(body.classList.contains('open')) {
            body.classList.remove('open');
        } else {
            // Close others (optional)
            document.querySelectorAll('.hotel-body').forEach(b => b.classList.remove('open'));
            body.classList.add('open');
        }
    }
</script>

<%- include('partials/footer') %>